{
  "schema_version": 2,
  "default_level": "L3",
  "paths": [
    {
      "glob": ".github/risk-paths.json",
      "level": "L2",
      "why": "governance: the high-risk path list"
    },
    {
      "glob": ".github/workflows/**",
      "level": "L2",
      "why": "governance: CI, the risk-paths caller and token permissions"
    },
    {
      "glob": "Makefile",
      "level": "L2",
      "why": "governance: the verify gate"
    },
    {
      "glob": "scripts/check-template.mjs",
      "level": "L2",
      "why": "governance: the template verification gate"
    },
    {
      "glob": "scripts/check-corrections.mjs",
      "level": "L2",
      "why": "governance: the corrections validation gate"
    },
    {
      "glob": "scripts/lib/**",
      "level": "L2",
      "why": "governance: the vendored risk-path validator and matcher"
    },
    {
      "glob": "mise.toml",
      "level": "L1",
      "why": "supply chain: the tool pins that CI installs"
    },
    {
      "glob": "mise.lock",
      "level": "L1",
      "why": "supply chain: the checksums of the tools that CI installs"
    }
  ]
}
